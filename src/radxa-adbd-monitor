#!/usr/bin/env bash

set -euo pipefail
shopt -s nullglob

# shortcut: matches this adbd StopWorker/wchan signature; revalidate on adbd or kernel changes.
wait_till_stalled() {
    local pid="" previous_pid="" count=0 task name stalled

    while sleep 1; do
        stalled=0
        if [[ -L "/sys/kernel/config/usb_gadget/$UDC/configs/r.1/ffs.adb" ]] && \
            pid=$(cat /run/adbd.pid 2>/dev/null) && [[ "$pid" =~ ^[0-9]+$ ]];
        then
            for task in /proc/"$pid"/task/*; do
                if read -r name 2>/dev/null < "$task/comm" && \
                    [[ "$name" == UsbFfs-monitor ]] && \
                    [[ "$(cat "$task/wchan" 2>/dev/null)" == hrtimer_nanosleep ]];
                then
                    stalled=1
                    break
                fi
            done
        else
            pid=""
        fi

        if [[ "$pid" != "$previous_pid" ]]; then
            count=0
        fi
        previous_pid="$pid"

        if ((stalled)); then
            if ((++count >= 3)); then
                return
            fi
        else
            count=0
        fi
    done
    return 1
}

wait_till_reconnect() {
    local is_connected new_state
    is_connected="$(<"/sys/class/udc/$UDC/state")"

    coproc inotifywait -r -m -e modify "/sys/class/udc/$UDC/state"

    while read -r -u "${COPROC[0]}"; do
        new_state="$(<"/sys/class/udc/$UDC/state")"
        case "$new_state" in
            "configured")
                if [[ "$is_connected" != "$new_state" ]];
                then
                    kill "$COPROC_PID"
                    return
                fi
                ;;
            *)
                is_connected="$new_state"
                ;;
        esac
    done
}

start() {
    if grep -zFxq -e 'allwinner,sun60i-a733' -e 'arm,sun60iw2p1' \
        /proc/device-tree/compatible 2>/dev/null;
    then
        while wait_till_stalled; do
            echo "Detected stalled adbd USB teardown." >&2
            systemctl try-restart "radxa-adbd@${UDC}.service"
        done
        return
    fi

    while true; do
        wait_till_reconnect
        echo "Detected reconnection event." >&2
        systemctl restart "radxa-adbd@${UDC}.service"
        sleep 1
    done
}

stop() {
    :
}

UDC=""
if [[ -e "/sys/class/udc/$1" ]];
then
    UDC="$1"
else
    echo "This UDC does not exist, you can turn on the OTG port Peripheral mode device tree overlay at rsetup and look in the /sys/class/udc directory for."
    echo "Usage: $0 <UDC> <start|stop|restart>"
    exit 1
fi

case "$2" in
start)
    start
    ;;
stop)
    stop
    ;;
restart|reload)
    stop
    start
    ;;
*)
    echo "Usage: $0 <UDC> <start|stop|restart>"
    exit 1
esac

exit 0
