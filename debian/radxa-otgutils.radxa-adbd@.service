[Unit]
Description=Enable adbd on %i
Documentation=https://github.com/radxa-pkg/radxa-otgutils/
ConditionPathIsSymbolicLink=/sys/class/udc/%i
Conflicts=adbd.service
After=radxa-adbd@%i.service
Before=adbd.service
Wants=radxa-adbd-monitor@%i.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/radxa-otgutils adbd %i start
ExecStop=/usr/sbin/radxa-otgutils adbd %i stop
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=radxa-otgutils.target
